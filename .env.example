PUBLISH_STARTER_PRODUCTS=false
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=wyxgolfsupply.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
